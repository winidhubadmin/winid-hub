# Copy this file to .env.local for local testing, or add these two values
# in Cloudflare Pages → Settings → Variables and Secrets.
# Find them in Supabase → Project Settings → Data API (Project URL) and API Keys (anon / publishable key).
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
